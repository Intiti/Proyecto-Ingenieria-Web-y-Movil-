# Copiar este archivo a .env y ajustar valores antes de levantar con docker-compose

# Base de datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=munisalud_db

# Backend
JWT_SECRET=cambiar_este_secreto_en_produccion
RUN_SEED=true

# Frontend
# URL que usará el frontend (build) para llamar al backend
VITE_API_URL=http://localhost:4000/api

# CORS: orígenes permitidos por el backend (separados por coma)
CORS_ORIGIN=http://localhost:8080

DATABASE_URL=postgresql://postgres:postgres@db:5432/munisalud_db?schema=public